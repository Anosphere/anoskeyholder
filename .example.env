# The machine file, .env: what differs per VM, written by
#
#   npm run make-keys -- --id <N>
#
# on the VM itself: the first four lines with values, then five lines left
# as "<fill in>" for the operator to fill, each under a comment saying what
# goes there. Everything shared by every VM is in network/testnet.env, which
# npm start loads first. This example is tracked; .env is not.

# This keyholder's number: its validator's id.
KEYHOLDER_ID=1
# The keyholder's own database role's password, 32 hex characters from make-keys.
PGPASSWORD=<32 hex characters>
# The read-only role's password in the anos database, 32 hex characters from make-keys.
ANOS_PGPASSWORD=<32 hex characters>
# The key file make-keys wrote: JSON { receivingX25519PrivateKey, receivingMlkemPrivateKey, bucketOneKey }, mode 0600.
KEY_FILE=./keyholder.key
# The Cloud KMS key's resource name, in your project and the VM's region: projects/<project>/locations/<region>/keyRings/anos-testnet/cryptoKeys/keyholder-<N>
KMS_KEY_NAME="<fill in>"
# The home computer's X25519 public key, raw hex (32 bytes), from the keyholder GUI.
HOME_X25519_PUBLIC_KEY="<fill in>"
# The home computer's ML-KEM-1024 public key, raw hex (1568 bytes), from the keyholder GUI.
HOME_MLKEM_PUBLIC_KEY="<fill in>"
# The first YubiKey's P-256 public key, a 33-byte compressed point in hex, from the keyholder GUI.
KEYHOLDER_PUBLIC_KEY_1="<fill in>"
# The second YubiKey's P-256 public key, a 33-byte compressed point in hex, from the keyholder GUI.
KEYHOLDER_PUBLIC_KEY_2="<fill in>"
