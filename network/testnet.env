# network/testnet.env: every value that is the same on every keyholder VM of
# the testnet. Committed; no secrets. npm start and the systemd unit load it
# first and .env, the machine file make-keys writes (the id, the database
# passwords, the key file, the five lines filled by hand), second, so .env
# wins where both name a variable:
#   node --env-file=network/testnet.env --env-file=.env src/server.js
#
# A value shown as "<fill in>" is filled by us once the address exists; the
# server refuses to start while one is still "<fill in>". Those values are in
# double quotes because the database scripts source this file with sh, which
# would read a bare < as a redirection; Node strips the quotes.

# The keyholder's own database, on the VM itself, over TCP: the role and the
# database scripts/setup-db.sh creates. The role's password is in .env.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=keyholdersoftware
PGDATABASE=keyholder

# The validator's anos database on the same VM, read only: the role
# scripts/grant-anos-read.sh creates, with SELECT on accounts and stakes.
# Its password is in .env.
ANOS_PGHOST=127.0.0.1
ANOS_PGPORT=5432
ANOS_PGUSER=keyholder_reader
ANOS_PGDATABASE=anos

# Where the keyholder listens. The doorman in front of the VM holds the
# external IP and forwards to this port.
PORT=3200

# Whole anos, the same values as the validator's network/testnet.env: the
# stake an account must hold to be a moderator or an attestor.
STAKE_MIN_MODERATOR_ANOS=1000
STAKE_MIN_ATTESTOR_ANOS=1000

# The wallet's origin for CORS: scheme, host and port, no path; a
# comma-separated list when there is more than one.
WEB_ORIGIN="<fill in>"

# The masterpod, asked /get-anopod-session-keys to verify a pod: its load
# balancer, scheme, host and port, no path.
MASTERPOD_URL="<fill in>"

# The hosts a decrypt route may post a share to: the masterpod's load
# balancer host alone, no scheme, no port; comma-separated when more than one.
RECOVERY_POD_HOSTS="<fill in>"

# How far a signed request's timestamp may be from the keyholder's clock,
# each way, in seconds. Nonces are kept twice this long.
TIMESTAMP_WINDOW_SECONDS=120
